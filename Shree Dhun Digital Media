<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Shree Dhun Digital Media</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family: Arial, sans-serif;
    }

    body{
      background:#000;
      color:white;
    }

    header{
      width:100%;
      height:100vh;
      background:linear-gradient(rgba(0,0,0,0.6),rgba(0,0,0,0.7)),
      url('https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?q=80&w=1200');
      background-size:cover;
      background-position:center;
      display:flex;
      justify-content:center;
      align-items:center;
      text-align:center;
      padding:20px;
    }

    .hero h1{
      font-size:60px;
      color:#ffcc00;
      margin-bottom:20px;
      text-shadow:2px 2px 10px black;
    }

    .hero p{
      font-size:22px;
      margin-bottom:30px;
    }

    .btn{
      display:inline-block;
      padding:14px 35px;
      background:#ff0000;
      color:white;
      text-decoration:none;
      border-radius:40px;
      font-size:18px;
      transition:0.3s;
    }

    .btn:hover{
      background:#ffcc00;
      color:black;
    }

    section{
      padding:70px 20px;
      text-align:center;
    }

    h2{
      font-size:40px;
      margin-bottom:20px;
      color:#ffcc00;
    }

    .about p{
      max-width:800px;
      margin:auto;
      line-height:1.8;
      font-size:18px;
    }

    .services{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:25px;
      margin-top:40px;
    }

    .card{
      background:#111;
      padding:30px;
      border-radius:15px;
      transition:0.3s;
      border:1px solid #222;
    }

    .card:hover{
      transform:translateY(-10px);
      border-color:#ffcc00;
    }

    .card h3{
      margin-bottom:15px;
      color:#ffcc00;
    }

    .gallery{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:20px;
      margin-top:40px;
    }

    .gallery img{
      width:100%;
      border-radius:15px;
      height:250px;
      object-fit:cover;
    }

    footer{
      background:#111;
      text-align:center;
      padding:25px;
      margin-top:40px;
      border-top:1px solid #222;
    }

    footer p{
      color:#aaa;
    }
  </style>
</head>

<body>

  <header>
    <div class="hero">
      <h1>Shree Dhun Digital Media</h1>
      <p>Bhojpuri Music • Digital Distribution • OTT Release • Video Production</p>
      <a href="#" class="btn">Explore Now</a>
    </div>
  </header>

  <section class="about">
    <h2>About Us</h2>
    <p>
      Shree Dhun Digital Media is a modern Bhojpuri music and entertainment platform.
      We create songs, music videos, OTT content, YouTube releases, and digital promotions
      with cinematic quality and viral marketing strategies.
    </p>
  </section>

  <section>
    <h2>Our Services</h2>

    <div class="services">

      <div class="card">
        <h3>🎵 Music Production</h3>
        <p>Professional Bhojpuri audio recording and music production.</p>
      </div>

      <div class="card">
        <h3>🎬 Video Production</h3>
        <p>4K cinematic video shoots and editing for music labels.</p>
      </div>

      <div class="card">
        <h3>📺 OTT Release</h3>
        <p>Release your songs and films on OTT platforms worldwide.</p>
      </div>

      <div class="card">
        <h3>📢 Digital Marketing</h3>
        <p>YouTube promotions, Instagram reels, Facebook ads & branding.</p>
      </div>

    </div>
  </section>

  <section>
    <h2>Gallery</h2>

    <div class="gallery">
      <img src="https://images.unsplash.com/photo-1511379938547-c1f69419868d?q=80&w=1000">
      <img src="https://images.unsplash.com/photo-1501612780327-45045538702b?q=80&w=1000">
      <img src="https://images.unsplash.com/photo-1499364615650-ec38552f4f34?q=80&w=1000">
    </div>
  </section>

  <footer>
    <p>© 2026 Shree Dhun Digital Media | All Rights Reserved</p>
  </footer>

</body>
</html>
